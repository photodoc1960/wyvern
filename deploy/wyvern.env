# Wyvern service configuration (read by the systemd unit via EnvironmentFile).

# REQUIRED: the interface that sees your LAN traffic (e.g. eth0, br-lan, enp3s0).
WYVERN_INTERFACE=eth0

# Dashboard bind address. 127.0.0.1 = localhost only (recommended).
# Set to 0.0.0.0 to reach it from other machines — then firewall TCP 8787.
WYVERN_WEB_HOST=127.0.0.1

# Where Wyvern stores its DB / baselines / forensic log.
# Matches the unit's StateDirectory (/var/lib/wyvern).
WYVERN_DATA_DIR=/var/lib/wyvern

# Optional: SMTP password for email digests. Keep secrets here, never in config.yaml.
# WYVERN_SMTP_PASSWORD=
